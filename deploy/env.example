# Copy to .env on the server. Never commit the real file.
PUBLIC_BASE=https://calendar-api.letstalkalberta.com
CALENDAR_PAGE=https://www.letstalkalberta.com/political-calendar
ALLOWED_ORIGINS=https://www.letstalkalberta.com,https://letstalkalberta.com
ADMIN_KEY=change-me-to-a-long-random-string

# AI reader (party sites, Elections Alberta pages, newspapers)
ANTHROPIC_API_KEY=
LTA_AI_MODEL=claude-sonnet-5-5

# Optional: emails drivers when someone asks for a seat
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=letstalkalberta@gmail.com

# Later, for the phone app's push notifications (Firebase)
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/firebase-service-account.json

# LTA Watcher hub
CHECK_EVERY_HOURS=6          # how often each website is checked
AI_DAILY_LIMIT=300           # cap on AI page reads per day (cost control)
AI_ENABLED=1                 # set to 0 to switch the AI reader off for every PC
LATEST_APP_VERSION=          # optional: tells PCs a new version is out
